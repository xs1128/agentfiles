#!/bin/sh
# Runs the agent image against the current directory, under whichever container
# runtime the box has. Usage: agent [--mcp web,cloud] [claude args...]
set -eu

IMAGE="${AGENT_IMAGE:-ghcr.io/xs1128/agentfiles:latest}"
STATE="${AGENT_STATE_DIR:-$HOME/.agent-state}"

if [ -z "${AGENT_ENV_FILE:-}" ]; then
  for candidate in ./.env "$HOME/.agent.env"; do
    [ -f "$candidate" ] && { AGENT_ENV_FILE="$candidate"; break; }
  done
fi

mcp=""
case "${1:-}" in
  --mcp) mcp="${2:?--mcp needs a comma-separated list, e.g. web,cloud}"; shift 2 ;;
  --mcp=*) mcp="${1#--mcp=}"; shift ;;
esac

claude_args=""
if [ -n "$mcp" ]; then
  IFS=,
  for category in $mcp; do
    claude_args="$claude_args --mcp-config /state/mcp/$category.json"
  done
  unset IFS
  claude_args="$claude_args --strict-mcp-config"
fi

mkdir -p "$STATE"

# The image bakes uid 1000, but /work and /state are yours. Run as you instead, so
# what the agent writes comes out owned by you and /state stays writable. An unknown
# uid has no passwd entry, and node throws on getpwuid, so supply one.
uid="$(id -u)"
gid="$(id -g)"
mkdir -p "$STATE/etc"
printf 'root:x:0:0:root:/state:/bin/sh\n' > "$STATE/etc/passwd"
printf 'root:x:0:\n' > "$STATE/etc/group"
if [ "$uid" -ne 0 ]; then
  printf 'agent:x:%s:%s:agent:/state:/bin/sh\n' "$uid" "$gid" >> "$STATE/etc/passwd"
  printf 'agent:x:%s:\n' "$gid" >> "$STATE/etc/group"
fi

runtime=""
for candidate in docker podman apptainer singularity enroot; do
  command -v "$candidate" >/dev/null 2>&1 && { runtime="$candidate"; break; }
done
[ -n "$runtime" ] || {
  echo "agent: no container runtime found (looked for docker, podman, apptainer, singularity, enroot)" >&2
  exit 1
}

case "$runtime" in
  docker|podman)
    set -- ${claude_args} "$@"
    [ -t 0 ] && tty=-t || tty=
    # Rootless podman maps the container uid into a subuid range, where it would own
    # neither mount; keep-id lands it back on ours.
    userns=
    [ "$runtime" = podman ] && [ "$uid" -ne 0 ] && userns=--userns=keep-id
    exec "$runtime" run --rm -i $tty \
      --user "$uid:$gid" $userns -e HOME=/state \
      -v "$STATE/etc/passwd:/etc/passwd:ro" \
      -v "$STATE/etc/group:/etc/group:ro" \
      -v "$PWD:$PWD" -w "$PWD" \
      -v "$STATE:/state" \
      ${AGENT_ENV_FILE:+--env-file "$AGENT_ENV_FILE"} \
      ${SSH_AUTH_SOCK:+-v "$SSH_AUTH_SOCK:/ssh-agent" -e SSH_AUTH_SOCK=/ssh-agent} \
      "$IMAGE" "$@"
    ;;
  apptainer|singularity)
    # --containall drops the host $HOME bind, which would otherwise land on top
    # of the image and take /state's contents with it.
    set -- ${claude_args} "$@"
    exec "$runtime" run --containall --no-home --pwd "$PWD" --env HOME=/state \
      --bind "$STATE/etc/passwd:/etc/passwd" \
      --bind "$STATE/etc/group:/etc/group" \
      --bind "$PWD:$PWD" \
      --bind "$STATE:/state" \
      ${AGENT_ENV_FILE:+--env-file "$AGENT_ENV_FILE"} \
      ${SSH_AUTH_SOCK:+--bind "$SSH_AUTH_SOCK:/ssh-agent" --env SSH_AUTH_SOCK=/ssh-agent} \
      "docker://$IMAGE" "$@"
    ;;
  enroot)
    name="agent-config"
    image_file="$STATE/images/$name.sqsh"
    if [ ! -f "$image_file" ]; then
      mkdir -p "$STATE/images"
      enroot import -o "$image_file" "docker://${IMAGE%%/*}#${IMAGE#*/}"
    fi
    enroot list | grep -qx "$name" || enroot create --name "$name" "$image_file"
    set -- ${claude_args} "$@"
    exec enroot start --env HOME=/state \
      --mount "$PWD:$PWD" \
      --mount "$STATE:/state" \
      ${AGENT_ENV_FILE:+--env-file "$AGENT_ENV_FILE"} \
      "$name" /opt/scripts/entrypoint.sh "$@"
    ;;
esac
