# Copy to .env (or ~/.agent.env) and fill in. Never committed, never in an image layer.

# Anthropic API key. Leave unset to use a subscription login instead, which the
# state dir persists once you have run /login inside the container.
ANTHROPIC_API_KEY=

# z.ai coding-plan key, only needed for the GLM profile in config/profiles/glm.
ZAI_API_KEY=
