# Copy to ~/.agent.env and fill in. Never committed.
#
# Only claude-glm reads this file, and only for ZAI_API_KEY. Everything else
# Claude Code takes from your shell environment as usual: export ANTHROPIC_API_KEY
# if you use an API key rather than a subscription login, and git identity comes
# from your own ~/.gitconfig.

# z.ai coding-plan key, needed by `claude-glm`.
ZAI_API_KEY=
