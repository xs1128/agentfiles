{
  "$comment": "Host tools the configs hard-depend on. install.sh checks these before linking.",
  "required": {
    "git": {
      "check": "git --version",
      "install": "xcode-select --install"
    },
    "python3": {
      "check": "python3 --version",
      "install": "brew install python"
    },
    "jq": {
      "check": "jq --version",
      "install": "brew install jq"
    }
  },
  "perAgent": {
    "claude": {
      "claude": {
        "check": "claude --version",
        "install": "curl -fsSL https://claude.ai/install.sh | bash",
        "why": "the agent itself"
      },
      "rtk": {
        "check": "rtk --version",
        "install": "brew install rtk",
        "why": "PreToolUse hook in claude/settings.json rewrites Bash calls through it"
      },
      "bun": {
        "check": "bun --version",
        "install": "curl -fsSL https://bun.sh/install | bash",
        "why": "claude-hud statusline is a bun TypeScript entrypoint"
      }
    },
    "codex": {
      "codex": {
        "check": "codex --version",
        "install": "npm i -g @openai/codex",
        "why": "the agent itself"
      },
      "rtk": {
        "check": "rtk --version",
        "install": "brew install rtk",
        "why": "codex/AGENTS.md instructs the model to prefix shell commands with it. Unlike Claude there is no hook, so a missing binary means every command fails rather than silently skipping the proxy"
      }
    },
    "pi": {
      "pi": {
        "check": "pi --version",
        "install": "brew install pi",
        "why": "the agent itself"
      }
    }
  },
  "optional": {
    "gh": {
      "check": "gh --version",
      "install": "brew install gh",
      "why": "skills that file issues (qa, to-tickets, triage)"
    },
    "go": {
      "check": "go version",
      "install": "brew install go",
      "why": "builds the ./tui installer front-end; install.sh/doctor.sh work without it"
    }
  }
}
