#!/bin/sh
set -eu
[ -n "${ZAI_API_KEY:-}" ] || ZAI_API_KEY=$(sed -n 's/^ZAI_API_KEY=//p' "$HOME/.agent.env" 2>/dev/null | head -1)
export ANTHROPIC_BASE_URL=https://api.z.ai/api/anthropic
export ANTHROPIC_AUTH_TOKEN="${ZAI_API_KEY:?put ZAI_API_KEY=... in ~/.agent.env}"
export ANTHROPIC_DEFAULT_OPUS_MODEL=glm-5.2 ANTHROPIC_DEFAULT_SONNET_MODEL=glm-5-turbo ANTHROPIC_DEFAULT_HAIKU_MODEL=glm-4.7
exec claude --model glm-5.2 "$@"
