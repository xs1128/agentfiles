#!/usr/bin/env bash
# Interactive front-end for install.sh / doctor.sh.
#
#   ./setup            build (if needed) and open the wizard
#   ./setup --rebuild   force a rebuild first
#
# The wizard owns no installation logic; it assembles a flag list and runs the
# same scripts. If Go is missing, or you'd rather not, everything it offers is
# one command away:
#
#   ./install.sh --all --dry-run
#   ./install.sh --claude --profile glm
#   ./doctor.sh

set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
. "$REPO_ROOT/lib/platform.sh"
BIN="$REPO_ROOT/.cache/agent-config-tui"
REBUILD=0
BOOTSTRAP=1

for arg in "$@"; do
  case "$arg" in
    --rebuild) REBUILD=1 ;;
    --no-bootstrap) BOOTSTRAP=0 ;;
    -h|--help) sed -n '2,13p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) printf 'unknown flag: %s (try --help)\n' "$arg" >&2; exit 1 ;;
  esac
done

if ! command -v go >/dev/null 2>&1; then
  [ "$BOOTSTRAP" = 1 ] && install_tui_dependencies
  command -v go >/dev/null 2>&1 || { printf 'Go is required to build the TUI.\n' >&2; exit 1; }
fi

# Rebuild when the binary is missing or any source is newer than it.
needs_build=$REBUILD
if [ ! -x "$BIN" ]; then
  needs_build=1
else
  while IFS= read -r src; do
    [ "$src" -nt "$BIN" ] && { needs_build=1; break; }
  done < <(find "$REPO_ROOT/tui" -name '*.go' -o -name 'go.mod' -o -name 'go.sum')
fi

if [ "$needs_build" = 1 ]; then
  printf 'building wizard…\n'
  mkdir -p "$(dirname "$BIN")"
  (cd "$REPO_ROOT/tui" && go build -o "$BIN" .)
fi

exec "$BIN" --repo "$REPO_ROOT"
