# The subset of ~/.codex/config.toml this repo owns. install.sh merges these in;
# it never overwrites the file. Left untouched because they hold machine-local
# paths or per-repo decisions: notify, [marketplaces.*], [mcp_servers.node_repl],
# [mcp_servers.computer-use], [shell_environment_policy], [projects.*], [tui.*],
# and model / model_reasoning_effort — a per-session choice made in Codex's own
# UI, so pinning them here silently reverted it on every install.
#
# [features] is deliberately absent: it used to pin js_repl = false, but
# `codex features list` now reports js_repl as `removed`. A merge only ever adds
# or overrides keys, so dropping it here leaves whatever Codex wrote alone.

approvals_reviewer = "user"

[desktop]
conversationDetailMode = "STEPS_COMMANDS"
sansFontSize = 14
codeFontSize = 13
ambient-suggestions-enabled = false
followUpQueueMode = "queue"
